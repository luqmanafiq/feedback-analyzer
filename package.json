{
  "name": "feedback-analyzer",
  "version": "1.0.0",
  "description": "Customer feedback aggregation and analysis tool using Cloudflare Workers",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create feedback-db",
    "db:init": "wrangler d1 execute feedback-db --file=./schema.sql",
    "db:seed": "wrangler d1 execute feedback-db --file=./seed.sql"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "feedback",
    "ai",
    "product-management"
  ],
  "author": "Luqman Afiq",
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
